<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#07111f">
  <meta name="description" content="CampusRelay routes official college circulars to the right people and tracks every acknowledgment.">
  <title>CampusRelay · Smart circulars</title>
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="/assets/icon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <svg class="icon-sprite" aria-hidden="true">
    <symbol id="i-logo" viewBox="0 0 24 24"><path d="M5 4.75A2.75 2.75 0 0 1 7.75 2h8.5A2.75 2.75 0 0 1 19 4.75v14.5A2.75 2.75 0 0 1 16.25 22h-8.5A2.75 2.75 0 0 1 5 19.25z"/><path d="M8.5 7h7M8.5 11h7M8.5 15h4"/><path d="M2 8.5h3M19 8.5h3"/></symbol>
    <symbol id="i-arrow" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></symbol>
    <symbol id="i-spark" viewBox="0 0 24 24"><path d="m12 3 1.3 4.2a5 5 0 0 0 3.4 3.4L21 12l-4.3 1.3a5 5 0 0 0-3.4 3.4L12 21l-1.3-4.3a5 5 0 0 0-3.4-3.4L3 12l4.3-1.4a5 5 0 0 0 3.4-3.4z"/></symbol>
    <symbol id="i-compose" viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4z"/></symbol>
    <symbol id="i-inbox" viewBox="0 0 24 24"><path d="M4 4h16v16H4z"/><path d="M4 13h4l2 3h4l2-3h4"/></symbol>
    <symbol id="i-users" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></symbol>
    <symbol id="i-user" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></symbol>
    <symbol id="i-bell" viewBox="0 0 24 24"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/></symbol>
    <symbol id="i-calendar" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></symbol>
    <symbol id="i-download" viewBox="0 0 24 24"><path d="M12 3v12m0 0 5-5m-5 5-5-5M4 21h16"/></symbol>
    <symbol id="i-check" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m8 12 2.5 2.5L16 9"/></symbol>
    <symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></symbol>
    <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
    <symbol id="i-close" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"/></symbol>
    <symbol id="i-send" viewBox="0 0 24 24"><path d="m22 2-7 20-4-9-9-4zM22 2 11 13"/></symbol>
    <symbol id="i-chart" viewBox="0 0 24 24"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></symbol>
    <symbol id="i-settings" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06-2.83 2.83-.06-.06a1.7 1.7 0 0 0-1.88-.34 1.7 1.7 0 0 0-1.03 1.56V21h-4v-.08A1.7 1.7 0 0 0 9 19.37a1.7 1.7 0 0 0-1.88.34l-.06.06-2.83-2.83.06-.06A1.7 1.7 0 0 0 4.63 15 1.7 1.7 0 0 0 3.08 14H3v-4h.08A1.7 1.7 0 0 0 4.63 9a1.7 1.7 0 0 0-.34-1.88l-.06-.06 2.83-2.83.06.06A1.7 1.7 0 0 0 9 4.63h.02A1.7 1.7 0 0 0 10 3.08V3h4v.08A1.7 1.7 0 0 0 15 4.63a1.7 1.7 0 0 0 1.88-.34l.06-.06 2.83 2.83-.06.06A1.7 1.7 0 0 0 19.37 9v.02A1.7 1.7 0 0 0 20.92 10H21v4h-.08A1.7 1.7 0 0 0 19.4 15Z"/></symbol>
    <symbol id="i-logout" viewBox="0 0 24 24"><path d="M10 17l5-5-5-5M15 12H3M21 19V5a2 2 0 0 0-2-2h-6"/></symbol>
    <symbol id="i-chevron" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></symbol>
    <symbol id="i-alert" viewBox="0 0 24 24"><path d="M10.3 3.7 2.6 17a2 2 0 0 0 1.7 3h15.4a2 2 0 0 0 1.7-3L13.7 3.7a2 2 0 0 0-3.4 0Z"/><path d="M12 9v4M12 17h.01"/></symbol>
  </svg>

  <div class="aurora aurora-one"></div>
  <div class="aurora aurora-two"></div>
  <main class="device" aria-label="CampusRelay application">
    <div id="offlineBanner" class="offline-banner hidden">You’re offline. Saved notices are still available.</div>

    <section id="landingScreen" class="screen screen-active" aria-labelledby="landingTitle">
      <header class="landing-top">
        <a class="wordmark" href="#" aria-label="CampusRelay home">
          <span class="logo-mark"><svg><use href="#i-logo"></use></svg></span>
          <span>CampusRelay</span>
        </a>
        <button class="icon-button" id="landingThemeButton" type="button" aria-label="Toggle theme"><svg><use href="#i-settings"></use></svg></button>
      </header>

      <div class="hero">
        <div class="eyebrow"><span class="live-dot"></span> Built for official campus communication</div>
        <h1 id="landingTitle">The right notice.<br><span>The right people.</span></h1>
        <p>Compose once, route intelligently, and know exactly who has read and acknowledged it.</p>
        <div class="hero-proof" aria-label="Product highlights">
          <span><svg><use href="#i-spark"></use></svg> Local AI routing</span>
          <span><svg><use href="#i-check"></use></svg> Accountable delivery</span>
        </div>
      </div>

      <div class="role-stack">
        <button class="role-card faculty-role" type="button" data-enter-role="faculty">
          <span class="role-icon"><svg><use href="#i-compose"></use></svg></span>
          <span class="role-copy"><strong>Continue as faculty</strong><small>Compose, send & track circulars</small></span>
          <svg class="chevron"><use href="#i-chevron"></use></svg>
        </button>
        <button class="role-card" type="button" data-enter-role="student">
          <span class="role-icon"><svg><use href="#i-inbox"></use></svg></span>
          <span class="role-copy"><strong>Continue as student</strong><small>Read notices meant for you</small></span>
          <svg class="chevron"><use href="#i-chevron"></use></svg>
        </button>
      </div>

      <div class="landing-metrics">
        <div><strong>Realtime</strong><span>Inbox updates</span></div>
        <div><strong>Private</strong><span>By membership</span></div>
        <div><strong>Installable</strong><span>Works as a PWA</span></div>
      </div>
      <p class="landing-footer">A local demo · No paid AI or delivery service required</p>
    </section>

    <section id="authScreen" class="screen hidden" aria-labelledby="authTitle">
      <header class="topbar">
        <button class="icon-button" type="button" data-back aria-label="Go back"><svg><use href="#i-arrow"></use></svg></button>
        <span class="mini-wordmark"><span class="logo-mark small"><svg><use href="#i-logo"></use></svg></span> CampusRelay</span>
        <span class="topbar-spacer"></span>
      </header>
      <div class="auth-heading">
        <span id="authRoleBadge" class="soft-badge">Faculty portal</span>
        <h2 id="authTitle">Welcome back</h2>
        <p id="authSubtitle">Sign in to compose and track official circulars.</p>
      </div>

      <div id="loginPanel">
        <form id="loginForm" class="form-stack" novalidate>
          <label class="field"><span>Email address</span><input id="loginEmail" name="email" type="email" autocomplete="username" required placeholder="you@campus.edu"></label>
          <label class="field"><span>Password</span><input id="loginPassword" name="password" type="password" autocomplete="current-password" required placeholder="Enter your password"></label>
          <p id="loginError" class="form-error hidden" role="alert"></p>
          <button id="loginButton" class="primary-button" type="submit"><span>Sign in securely</span><svg><use href="#i-chevron"></use></svg></button>
        </form>

        <div class="divider"><span>or try the guided demo</span></div>
        <button id="demoLoginButton" class="demo-login" type="button">
          <span class="avatar demo-avatar" id="demoAvatar">FP</span>
          <span><strong id="demoName">Dr. Maya Patel</strong><small id="demoDescription">Faculty demo · password filled for you</small></span>
          <span class="try-label">Try now</span>
        </button>
        <button id="showRegisterButton" class="text-button hidden" type="button">New student? Create your account</button>
      </div>

      <form id="registerPanel" class="form-stack hidden" novalidate>
        <button id="backToLoginButton" class="text-button text-left" type="button">← Back to sign in</button>
        <label class="field"><span>Full name</span><input name="name" autocomplete="name" required placeholder="Your full name"></label>
        <label class="field"><span>College email</span><input name="email" type="email" autocomplete="email" required placeholder="you@campus.edu"></label>
        <label class="field"><span>Create password</span><input name="password" type="password" minlength="8" autocomplete="new-password" required placeholder="At least 8 characters"></label>
        <label class="field"><span>Study year</span><select name="year" required><option value="">Choose your year</option><option value="1">First year</option><option value="2">Second year</option><option value="3">Third year</option><option value="4">Final year</option></select></label>
        <fieldset class="check-field"><legend>Activity groups <small>Optional</small></legend><div id="registerActivities" class="check-grid"><span class="skeleton-line"></span></div></fieldset>
        <p id="registerError" class="form-error hidden" role="alert"></p>
        <button class="primary-button" type="submit">Create student account</button>
      </form>
      <div class="auth-security"><svg><use href="#i-check"></use></svg><span>Passwords are hashed. Your audience is enforced by the server, not hidden by the UI.</span></div>
    </section>

    <section id="facultyScreen" class="screen app-screen hidden" aria-labelledby="facultyHeading">
      <header class="app-topbar">
        <div><p class="overline">Faculty portal</p><h2 id="facultyHeading">Good morning, <span data-user-first-name>Faculty</span></h2></div>
        <button class="avatar-button" type="button" data-faculty-view="account" aria-label="Open account"><span class="avatar" data-user-initials>FP</span><span class="online-dot"></span></button>
      </header>

      <div class="view-scroll">
        <section id="facultyComposeView" class="tab-view">
          <div class="status-strip">
            <span><span class="live-dot"></span><strong>Delivery brain online</strong></span>
            <small id="realtimeStatus">Realtime connected</small>
          </div>
          <div class="section-heading"><div><p class="overline">New circular</p><h3>What should everyone know?</h3></div><span id="draftStatus" class="draft-status">Draft</span></div>
          <form id="composerForm">
            <label class="composer">
              <span class="sr-only">Circular message</span>
              <textarea id="circularText" maxlength="1600" required placeholder="Try: The inter-college football fixture is on 18 September at 10 AM. Team members must report by 9:30..."></textarea>
              <span class="composer-meta"><span><svg><use href="#i-spark"></use></svg> Smart Compose watches as you type</span><span id="characterCount">0 / 1600</span></span>
            </label>

            <div id="smartPanel" class="smart-panel" aria-live="polite">
              <div class="smart-header"><span class="smart-title"><span class="ai-icon"><svg><use href="#i-spark"></use></svg></span><span><strong>Smart suggestions</strong><small id="smartStatus">Start typing to analyze your notice</small></span></span><span id="aiModeBadge" class="model-badge">Local</span></div>
              <div class="suggestion-block">
                <div class="label-row"><span>Audience</span><button id="openAudienceButton" class="inline-button" type="button"><svg><use href="#i-plus"></use></svg> Add group</button></div>
                <div id="selectedTargets" class="chip-row"><span class="empty-chip-copy">No audience selected yet</span></div>
                <div id="suggestedTargets" class="suggested-row hidden"></div>
              </div>
              <div class="analysis-grid">
                <label class="mini-field"><span><svg><use href="#i-calendar"></use></svg> Event date</span><input id="detectedDate" name="detectedDate" type="datetime-local"></label>
                <div class="mini-field"><span><svg><use href="#i-alert"></use></svg> Priority</span><div class="segmented" id="urgencyControl"><button type="button" data-urgency="fyi">FYI</button><button class="active" type="button" data-urgency="normal">Normal</button><button type="button" data-urgency="urgent">Urgent</button></div></div>
              </div>
              <label class="summary-field"><span>One-line summary <small>Editable</small></span><input id="circularSummary" maxlength="160" placeholder="A concise preview will appear here"></label>
              <label class="toggle-row"><span><strong>Require acknowledgment</strong><small>Students must explicitly confirm this notice</small></span><input id="requiresAck" type="checkbox" role="switch"><span class="toggle-ui"></span></label>
            </div>
            <p id="composeError" class="form-error hidden" role="alert"></p>
            <button id="reviewCircularButton" class="primary-button send-button" type="submit"><span>Review & send</span><svg><use href="#i-send"></use></svg></button>
          </form>
        </section>

        <section id="facultySentView" class="tab-view hidden">
          <div class="section-heading"><div><p class="overline">Accountability</p><h3>Sent circulars</h3></div><button id="refreshSentButton" class="icon-button" type="button" aria-label="Refresh sent circulars"><svg><use href="#i-clock"></use></svg></button></div>
          <div id="facultyStats" class="stat-grid"><div><span class="skeleton-line"></span></div><div><span class="skeleton-line"></span></div><div><span class="skeleton-line"></span></div></div>
          <div id="sentCircularList" class="card-list"><div class="skeleton-card"></div><div class="skeleton-card"></div></div>
        </section>

        <section id="facultyGroupsView" class="tab-view hidden">
          <div class="section-heading"><div><p class="overline">Audience directory</p><h3>Groups & memberships</h3></div><button id="createGroupButton" class="round-add" type="button" aria-label="Create a group"><svg><use href="#i-plus"></use></svg></button></div>
          <p class="view-intro">Year and college-wide groups are automatic. Faculty can create and manage custom audiences.</p>
          <div id="facultyGroupList" class="card-list"><div class="skeleton-card"></div></div>
        </section>

        <section id="facultyAccountView" class="tab-view hidden">
          <div id="facultyProfile" class="profile-card"></div>
          <div class="settings-list">
            <button type="button" data-theme-toggle><span class="setting-icon"><svg><use href="#i-settings"></use></svg></span><span><strong>Appearance</strong><small>Switch light or dark theme</small></span><svg class="chevron"><use href="#i-chevron"></use></svg></button>
            <button type="button" data-install-app class="hidden"><span class="setting-icon"><svg><use href="#i-download"></use></svg></span><span><strong>Install CampusRelay</strong><small>Add this app to your home screen</small></span><svg class="chevron"><use href="#i-chevron"></use></svg></button>
            <button type="button" data-logout class="danger-row"><span class="setting-icon"><svg><use href="#i-logout"></use></svg></span><span><strong>Sign out</strong><small>Return to the welcome screen</small></span></button>
          </div>
          <div class="build-note">Demo build · Persistent SQLite data · Local classifier</div>
        </section>
      </div>

      <nav class="bottom-nav" aria-label="Faculty navigation">
        <button class="active" type="button" data-faculty-view="compose"><svg><use href="#i-compose"></use></svg><span>Compose</span></button>
        <button type="button" data-faculty-view="sent"><svg><use href="#i-chart"></use></svg><span>Sent</span></button>
        <button type="button" data-faculty-view="groups"><svg><use href="#i-users"></use></svg><span>Groups</span></button>
        <button type="button" data-faculty-view="account"><svg><use href="#i-user"></use></svg><span>Account</span></button>
      </nav>
    </section>

    <section id="studentScreen" class="screen app-screen hidden" aria-labelledby="studentHeading">
      <header class="app-topbar">
        <div><p class="overline">Student inbox</p><h2 id="studentHeading">Hello, <span data-user-first-name>Student</span></h2></div>
        <button class="avatar-button" type="button" data-student-view="account" aria-label="Open account"><span class="avatar" data-user-initials>ST</span><span class="online-dot"></span></button>
      </header>

      <div class="view-scroll">
        <section id="studentInboxView" class="tab-view">
          <div class="inbox-heading"><div><h3>Your circulars</h3><p id="inboxSubtitle">Only notices for your groups appear here.</p></div><button id="enablePushButton" class="notification-button" type="button" title="Enable notifications"><svg><use href="#i-bell"></use></svg><span id="unreadBadge" class="nav-badge hidden">0</span></button></div>
          <div id="inboxFilters" class="filter-row"><button class="active" type="button" data-filter="all">All</button><button type="button" data-filter="unread">Unread</button><button type="button" data-filter="urgent">Urgent</button></div>
          <div id="inboxList" class="card-list inbox-list"><div class="skeleton-card"></div><div class="skeleton-card"></div></div>
        </section>

        <section id="studentGroupsView" class="tab-view hidden">
          <div class="section-heading"><div><p class="overline">Your audience</p><h3>Group memberships</h3></div></div>
          <p class="view-intro">Your study year is automatic. Choose any activity groups you want to follow.</p>
          <form id="membershipForm"><div id="studentGroupList" class="card-list"><div class="skeleton-card"></div></div><button class="primary-button" type="submit">Save activity groups</button></form>
        </section>

        <section id="studentAccountView" class="tab-view hidden">
          <div id="studentProfile" class="profile-card"></div>
          <div class="settings-list">
            <button id="accountPushButton" type="button"><span class="setting-icon"><svg><use href="#i-bell"></use></svg></span><span><strong>Browser notifications</strong><small id="pushPermissionLabel">Turn on delivery while the app is closed</small></span><svg class="chevron"><use href="#i-chevron"></use></svg></button>
            <button type="button" data-theme-toggle><span class="setting-icon"><svg><use href="#i-settings"></use></svg></span><span><strong>Appearance</strong><small>Switch light or dark theme</small></span><svg class="chevron"><use href="#i-chevron"></use></svg></button>
            <button type="button" data-install-app class="hidden"><span class="setting-icon"><svg><use href="#i-download"></use></svg></span><span><strong>Install CampusRelay</strong><small>Add this app to your home screen</small></span><svg class="chevron"><use href="#i-chevron"></use></svg></button>
            <button type="button" data-logout class="danger-row"><span class="setting-icon"><svg><use href="#i-logout"></use></svg></span><span><strong>Sign out</strong><small>Return to the welcome screen</small></span></button>
          </div>
        </section>
      </div>
      <nav class="bottom-nav student-nav" aria-label="Student navigation">
        <button class="active" type="button" data-student-view="inbox"><svg><use href="#i-inbox"></use></svg><span>Inbox</span><span id="bottomUnreadBadge" class="nav-badge hidden">0</span></button>
        <button type="button" data-student-view="groups"><svg><use href="#i-users"></use></svg><span>Groups</span></button>
        <button type="button" data-student-view="account"><svg><use href="#i-user"></use></svg><span>Account</span></button>
      </nav>
    </section>

    <section id="noticeScreen" class="screen app-screen detail-screen hidden" aria-labelledby="noticeTitle">
      <header class="topbar detail-topbar"><button class="icon-button" type="button" data-back aria-label="Back to inbox"><svg><use href="#i-arrow"></use></svg></button><span>Official circular</span><button id="detailDownloadButton" class="icon-button" type="button" aria-label="Download notice"><svg><use href="#i-download"></use></svg></button></header>
      <div id="noticeDetail" class="view-scroll detail-content"></div>
      <div id="acknowledgmentBar" class="sticky-action hidden"><div><strong>Confirmation required</strong><small>Let faculty know you’ve received this.</small></div><button id="acknowledgeButton" class="primary-button" type="button"><svg><use href="#i-check"></use></svg> Acknowledge</button></div>
    </section>

    <section id="analyticsScreen" class="screen app-screen detail-screen hidden" aria-labelledby="analyticsTitle">
      <header class="topbar detail-topbar"><button class="icon-button" type="button" data-back aria-label="Back to sent circulars"><svg><use href="#i-arrow"></use></svg></button><span id="analyticsTitle">Delivery report</span><button id="refreshAnalyticsButton" class="icon-button" type="button" aria-label="Refresh report"><svg><use href="#i-clock"></use></svg></button></header>
      <div id="analyticsDetail" class="view-scroll detail-content"></div>
    </section>
  </main>

  <dialog id="audienceDialog" class="sheet-dialog">
    <form method="dialog" class="sheet">
      <div class="sheet-handle"></div>
      <div class="sheet-header"><div><p class="overline">Audience picker</p><h3>Choose target groups</h3></div><button class="icon-button" value="cancel" aria-label="Close"><svg><use href="#i-close"></use></svg></button></div>
      <label class="search-field"><span class="sr-only">Search groups</span><input id="audienceSearch" type="search" placeholder="Search year, activity or custom groups"></label>
      <div id="audienceOptions" class="option-list"></div>
      <button id="applyAudienceButton" class="primary-button" value="cancel" type="button">Use selected groups</button>
    </form>
  </dialog>

  <dialog id="reviewDialog" class="sheet-dialog">
    <div class="sheet review-sheet">
      <div class="sheet-handle"></div>
      <div class="sheet-header"><div><p class="overline">Final check</p><h3>Ready to send?</h3></div><button id="closeReviewButton" class="icon-button" type="button" aria-label="Close"><svg><use href="#i-close"></use></svg></button></div>
      <div id="reviewContent"></div>
      <div class="review-actions"><button id="editDraftButton" class="secondary-button" type="button">Keep editing</button><button id="confirmSendButton" class="primary-button" type="button"><span>Send circular</span><svg><use href="#i-send"></use></svg></button></div>
    </div>
  </dialog>

  <dialog id="createGroupDialog" class="sheet-dialog">
    <form id="createGroupForm" class="sheet">
      <div class="sheet-handle"></div>
      <div class="sheet-header"><div><p class="overline">Custom audience</p><h3>Create a group</h3></div><button class="icon-button" type="button" data-close-dialog="createGroupDialog" aria-label="Close"><svg><use href="#i-close"></use></svg></button></div>
      <label class="field"><span>Group name</span><input name="name" maxlength="60" required placeholder="e.g. Photography Club"></label>
      <label class="field"><span>Description</span><textarea name="description" maxlength="180" required placeholder="What topics and members does this group cover?"></textarea></label>
      <label class="field"><span>Icon</span><input name="icon" maxlength="4" value="CR" aria-describedby="iconHint"><small id="iconHint">Use up to four letters.</small></label>
      <p id="createGroupError" class="form-error hidden"></p>
      <button class="primary-button" type="submit">Create group</button>
    </form>
  </dialog>

  <dialog id="membersDialog" class="sheet-dialog">
    <form id="membersForm" class="sheet">
      <div class="sheet-handle"></div>
      <div class="sheet-header"><div><p class="overline">Memberships</p><h3 id="membersDialogTitle">Manage members</h3></div><button class="icon-button" type="button" data-close-dialog="membersDialog" aria-label="Close"><svg><use href="#i-close"></use></svg></button></div>
      <div id="memberOptions" class="option-list"></div>
      <button class="primary-button" type="submit">Save members</button>
    </form>
  </dialog>

  <div id="toastRegion" class="toast-region" aria-live="polite" aria-atomic="true"></div>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/script.js" defer></script>
</body>
</html>
