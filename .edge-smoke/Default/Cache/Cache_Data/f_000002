:root {
  color-scheme: dark;
  --canvas: #050b14;
  --canvas-mid: #071525;
  --shell: #091526;
  --surface: #0f1e33;
  --surface-2: #14263f;
  --surface-3: #19304e;
  --text: #f6f8fc;
  --text-soft: #d5deeb;
  --muted: #91a1b8;
  --faint: #697a92;
  --line: rgba(255, 255, 255, 0.085);
  --line-strong: rgba(255, 255, 255, 0.14);
  --mint: #63e6be;
  --mint-bright: #80f3d0;
  --mint-ink: #05241d;
  --mint-soft: rgba(99, 230, 190, 0.12);
  --azure: #55a7ff;
  --azure-soft: rgba(85, 167, 255, 0.13);
  --urgent: #fb7185;
  --urgent-soft: rgba(251, 113, 133, 0.13);
  --warning: #fbbf24;
  --warning-soft: rgba(251, 191, 36, 0.12);
  --success: #34d399;
  --danger: #ff6b7f;
  --shadow: 0 35px 100px rgba(0, 0, 0, 0.48);
  --radius-sm: 12px;
  --radius: 18px;
  --radius-lg: 24px;
  --radius-xl: 32px;
  --ease: 180ms cubic-bezier(0.22, 1, 0.36, 1);
}

html[data-theme="light"] {
  color-scheme: light;
  --canvas: #dfe8f0;
  --canvas-mid: #edf3f7;
  --shell: #f8fafc;
  --surface: #ffffff;
  --surface-2: #f0f5f7;
  --surface-3: #e6eef3;
  --text: #0b1827;
  --text-soft: #26384d;
  --muted: #607188;
  --faint: #8291a4;
  --line: rgba(11, 24, 39, 0.09);
  --line-strong: rgba(11, 24, 39, 0.15);
  --mint: #0dbb8a;
  --mint-bright: #18c998;
  --mint-ink: #ffffff;
  --mint-soft: rgba(13, 187, 138, 0.11);
  --azure: #247bd1;
  --azure-soft: rgba(36, 123, 209, 0.1);
  --urgent: #db405b;
  --urgent-soft: rgba(219, 64, 91, 0.1);
  --warning: #c68100;
  --warning-soft: rgba(198, 129, 0, 0.1);
  --shadow: 0 32px 80px rgba(26, 48, 66, 0.2);
}

* {
  box-sizing: border-box;
}

html {
  min-height: 100%;
  background: var(--canvas);
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  min-height: 100dvh;
  overflow-x: hidden;
  color: var(--text);
  background:
    radial-gradient(circle at 50% -20%, rgba(52, 121, 187, 0.32), transparent 44%),
    linear-gradient(145deg, var(--canvas-mid), var(--canvas));
  font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  -webkit-font-smoothing: antialiased;
}

button,
input,
textarea,
select {
  font: inherit;
}

button,
a,
input,
textarea,
select {
  -webkit-tap-highlight-color: transparent;
}

button {
  color: inherit;
}

button:not(:disabled),
select:not(:disabled),
input[type="checkbox"]:not(:disabled) {
  cursor: pointer;
}

button:disabled {
  cursor: not-allowed;
  opacity: 0.55;
}

:focus-visible {
  outline: 3px solid color-mix(in srgb, var(--azure) 78%, white);
  outline-offset: 3px;
}

svg {
  width: 1.25em;
  height: 1.25em;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.icon-sprite {
  position: fixed;
  width: 0;
  height: 0;
  overflow: hidden;
}

.hidden {
  display: none !important;
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.aurora {
  position: fixed;
  z-index: -1;
  border-radius: 50%;
  filter: blur(80px);
  opacity: 0.19;
  pointer-events: none;
}

.aurora-one {
  top: 12%;
  left: max(5%, calc(50% - 540px));
  width: 360px;
  height: 360px;
  background: #2b8ec9;
}

.aurora-two {
  right: max(3%, calc(50% - 520px));
  bottom: 10%;
  width: 320px;
  height: 320px;
  background: #24b88e;
}

.device {
  position: relative;
  width: min(438px, calc(100vw - 32px));
  height: min(880px, calc(100dvh - 32px));
  min-height: 680px;
  margin: 16px auto;
  overflow: hidden;
  background: var(--shell);
  border: 1px solid var(--line-strong);
  border-radius: 42px;
  box-shadow: var(--shadow), inset 0 1px 0 rgba(255, 255, 255, 0.06);
  isolation: isolate;
}

.device::before {
  content: "";
  position: absolute;
  z-index: 15;
  top: 10px;
  left: 50%;
  width: 78px;
  height: 5px;
  transform: translateX(-50%);
  border-radius: 10px;
  background: color-mix(in srgb, var(--text) 18%, transparent);
  pointer-events: none;
}

.screen {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding: 30px 22px 22px;
  background:
    radial-gradient(circle at 85% 0%, rgba(71, 150, 209, 0.08), transparent 33%),
    var(--shell);
  animation: screen-in var(--ease) both;
}

.screen.screen-exit {
  animation: screen-out 140ms ease both;
}

@keyframes screen-in {
  from { opacity: 0; transform: translateX(14px); }
  to { opacity: 1; transform: translateX(0); }
}

@keyframes screen-out {
  to { opacity: 0; transform: translateX(-10px); }
}

.offline-banner {
  position: absolute;
  z-index: 30;
  top: 19px;
  left: 50%;
  width: max-content;
  max-width: calc(100% - 44px);
  padding: 8px 13px;
  transform: translateX(-50%);
  border: 1px solid color-mix(in srgb, var(--warning) 30%, transparent);
  border-radius: 999px;
  color: var(--warning);
  background: color-mix(in srgb, var(--surface) 92%, transparent);
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.2);
  font-size: 0.76rem;
  font-weight: 700;
}

.landing-top,
.topbar,
.app-topbar {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
}

.wordmark,
.mini-wordmark {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: var(--text);
  font-weight: 780;
  letter-spacing: -0.025em;
  text-decoration: none;
}

.logo-mark {
  display: inline-grid;
  width: 36px;
  height: 36px;
  place-items: center;
  border: 1px solid rgba(99, 230, 190, 0.28);
  border-radius: 12px;
  color: var(--mint);
  background: var(--mint-soft);
}

.logo-mark.small {
  width: 31px;
  height: 31px;
  border-radius: 10px;
}

.logo-mark svg {
  width: 20px;
  height: 20px;
}

.icon-button {
  display: inline-grid;
  flex: 0 0 auto;
  width: 42px;
  height: 42px;
  padding: 0;
  place-items: center;
  border: 1px solid var(--line);
  border-radius: 14px;
  color: var(--text-soft);
  background: color-mix(in srgb, var(--surface) 72%, transparent);
  transition: background var(--ease), border-color var(--ease), transform var(--ease);
}

.icon-button:hover {
  border-color: var(--line-strong);
  background: var(--surface-2);
  transform: translateY(-1px);
}

.hero {
  margin-top: clamp(38px, 7vh, 68px);
}

.eyebrow,
.soft-badge,
.model-badge,
.status-pill,
.kind-pill,
.draft-status {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  width: fit-content;
  border-radius: 999px;
  font-size: 0.71rem;
  font-weight: 750;
  letter-spacing: 0.02em;
}

.eyebrow {
  padding: 7px 10px;
  color: var(--mint);
  background: var(--mint-soft);
}

.live-dot,
.online-dot {
  display: inline-block;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--success);
  box-shadow: 0 0 0 4px rgba(52, 211, 153, 0.1);
}

.hero h1 {
  margin: 20px 0 14px;
  font-size: clamp(2.3rem, 9vw, 3rem);
  line-height: 0.99;
  letter-spacing: -0.058em;
}

.hero h1 span {
  color: var(--mint);
}

.hero > p {
  max-width: 360px;
  margin: 0;
  color: var(--muted);
  font-size: 0.98rem;
  line-height: 1.65;
}

.hero-proof {
  display: flex;
  flex-wrap: wrap;
  gap: 9px 16px;
  margin-top: 20px;
  color: var(--text-soft);
  font-size: 0.75rem;
  font-weight: 650;
}

.hero-proof span {
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.hero-proof svg {
  color: var(--mint);
}

.role-stack {
  display: grid;
  gap: 10px;
  margin-top: auto;
  padding-top: 30px;
}

.role-card {
  display: grid;
  grid-template-columns: 46px 1fr 20px;
  gap: 13px;
  align-items: center;
  width: 100%;
  min-height: 78px;
  padding: 14px;
  text-align: left;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--surface);
  box-shadow: 0 9px 26px rgba(0, 0, 0, 0.11);
  transition: transform var(--ease), border-color var(--ease), background var(--ease);
}

.role-card:hover {
  transform: translateY(-2px);
  border-color: color-mix(in srgb, var(--mint) 38%, var(--line));
  background: color-mix(in srgb, var(--surface-2) 72%, var(--surface));
}

.role-card.faculty-role {
  border-color: rgba(99, 230, 190, 0.24);
  background: linear-gradient(105deg, var(--mint-soft), var(--surface) 42%);
}

.role-icon,
.setting-icon {
  display: inline-grid;
  place-items: center;
  color: var(--mint);
  background: var(--mint-soft);
}

.role-icon {
  width: 46px;
  height: 46px;
  border-radius: 15px;
}

.role-copy {
  display: grid;
  gap: 4px;
}

.role-copy strong {
  font-size: 0.94rem;
}

.role-copy small,
.settings-list small,
.demo-login small {
  color: var(--muted);
  font-size: 0.74rem;
  line-height: 1.35;
}

.chevron {
  color: var(--faint);
}

.landing-metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
  margin-top: 18px;
  padding: 13px 3px;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.landing-metrics div {
  display: grid;
  gap: 3px;
  text-align: center;
}

.landing-metrics div + div {
  border-left: 1px solid var(--line);
}

.landing-metrics strong {
  font-size: 0.7rem;
}

.landing-metrics span,
.landing-footer {
  color: var(--faint);
  font-size: 0.62rem;
}

.landing-footer {
  margin: 12px 0 0;
  text-align: center;
}

.topbar {
  min-height: 46px;
}

.topbar-spacer {
  width: 42px;
}

.auth-heading {
  margin-top: 42px;
}

.soft-badge {
  padding: 6px 10px;
  color: var(--azure);
  background: var(--azure-soft);
}

.auth-heading h2 {
  margin: 15px 0 7px;
  font-size: 1.85rem;
  letter-spacing: -0.045em;
}

.auth-heading p,
.view-intro,
.inbox-heading p {
  margin: 0;
  color: var(--muted);
  font-size: 0.82rem;
  line-height: 1.5;
}

#loginPanel,
#registerPanel {
  margin-top: 28px;
}

.form-stack {
  display: grid;
  gap: 15px;
}

.field,
.check-field,
.summary-field {
  display: grid;
  gap: 8px;
}

.field > span,
.check-field legend,
.summary-field > span,
.label-row,
.mini-field > span {
  color: var(--text-soft);
  font-size: 0.75rem;
  font-weight: 700;
}

.field small,
.summary-field small,
.check-field small {
  color: var(--faint);
  font-weight: 500;
}

input,
textarea,
select {
  width: 100%;
  min-height: 48px;
  padding: 12px 14px;
  border: 1px solid var(--line-strong);
  border-radius: 14px;
  outline: 0;
  color: var(--text);
  background: color-mix(in srgb, var(--surface-2) 65%, transparent);
  transition: border-color var(--ease), box-shadow var(--ease), background var(--ease);
}

input:focus,
textarea:focus,
select:focus {
  border-color: color-mix(in srgb, var(--mint) 60%, var(--line));
  background: var(--surface-2);
  box-shadow: 0 0 0 3px var(--mint-soft);
}

input::placeholder,
textarea::placeholder {
  color: var(--faint);
}

select {
  appearance: none;
  background-image: linear-gradient(45deg, transparent 50%, var(--muted) 50%), linear-gradient(135deg, var(--muted) 50%, transparent 50%);
  background-position: calc(100% - 18px) calc(50% - 2px), calc(100% - 13px) calc(50% - 2px);
  background-size: 5px 5px, 5px 5px;
  background-repeat: no-repeat;
}

textarea {
  min-height: 108px;
  resize: vertical;
  line-height: 1.55;
}

.primary-button,
.secondary-button {
  display: inline-flex;
  min-height: 50px;
  align-items: center;
  justify-content: center;
  gap: 9px;
  padding: 12px 18px;
  border-radius: 15px;
  font-weight: 780;
  border: 0;
  transition: transform var(--ease), filter var(--ease), box-shadow var(--ease);
}

.primary-button {
  color: var(--mint-ink);
  background: linear-gradient(135deg, var(--mint-bright), color-mix(in srgb, var(--mint) 66%, var(--azure)));
  box-shadow: 0 10px 24px rgba(45, 210, 166, 0.15);
}

.primary-button:hover:not(:disabled),
.secondary-button:hover:not(:disabled) {
  filter: brightness(1.06);
  transform: translateY(-1px);
}

.secondary-button {
  color: var(--text-soft);
  background: var(--surface-2);
  border: 1px solid var(--line);
}

.form-stack > .primary-button,
.send-button,
#membershipForm > .primary-button,
.sheet > .primary-button {
  width: 100%;
}

.form-error {
  margin: -3px 0 0;
  padding: 10px 12px;
  border: 1px solid rgba(251, 113, 133, 0.2);
  border-radius: 12px;
  color: var(--urgent);
  background: var(--urgent-soft);
  font-size: 0.77rem;
  line-height: 1.45;
}

.divider {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 22px 0 15px;
  color: var(--faint);
  font-size: 0.68rem;
}

.divider::before,
.divider::after {
  content: "";
  flex: 1;
  height: 1px;
  background: var(--line);
}

.demo-login {
  display: grid;
  grid-template-columns: 42px 1fr auto;
  gap: 11px;
  align-items: center;
  width: 100%;
  padding: 12px;
  text-align: left;
  border: 1px solid var(--line);
  border-radius: 16px;
  background: var(--surface);
}

.demo-login > span:nth-child(2) {
  display: grid;
  gap: 3px;
}

.avatar,
.group-monogram {
  display: inline-grid;
  place-items: center;
  border-radius: 50%;
  color: var(--mint-ink);
  background: linear-gradient(135deg, var(--mint-bright), var(--azure));
  font-size: 0.72rem;
  font-weight: 850;
}

.avatar {
  width: 42px;
  height: 42px;
}

.try-label {
  color: var(--mint);
  font-size: 0.7rem;
  font-weight: 800;
}

.text-button,
.inline-button {
  padding: 5px;
  border: 0;
  color: var(--mint);
  background: transparent;
  font-size: 0.75rem;
  font-weight: 720;
}

.text-button {
  display: block;
  margin: 15px auto 0;
}

.text-left {
  margin: 0 auto 0 0;
}

.auth-security {
  display: flex;
  gap: 9px;
  margin-top: auto;
  padding-top: 18px;
  color: var(--faint);
  font-size: 0.65rem;
  line-height: 1.45;
}

.auth-security svg {
  flex: 0 0 auto;
  color: var(--mint);
}

.check-field {
  min-width: 0;
  padding: 0;
  border: 0;
}

.check-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.check-option {
  position: relative;
}

.check-option input {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}

.check-option span {
  display: inline-flex;
  min-height: 38px;
  align-items: center;
  padding: 8px 11px;
  border: 1px solid var(--line);
  border-radius: 999px;
  color: var(--muted);
  background: var(--surface);
  font-size: 0.73rem;
  font-weight: 650;
}

.check-option input:checked + span {
  border-color: color-mix(in srgb, var(--mint) 42%, var(--line));
  color: var(--mint);
  background: var(--mint-soft);
}

.app-screen {
  padding: 31px 0 0;
}

.app-topbar {
  padding: 0 20px 16px;
}

.overline {
  margin: 0 0 4px;
  color: var(--faint);
  font-size: 0.64rem;
  font-weight: 780;
  letter-spacing: 0.115em;
  text-transform: uppercase;
}

.app-topbar h2 {
  margin: 0;
  font-size: 1.27rem;
  letter-spacing: -0.035em;
}

.avatar-button {
  position: relative;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: none;
}

.avatar-button .online-dot {
  position: absolute;
  right: 0;
  bottom: 1px;
  width: 9px;
  height: 9px;
  border: 2px solid var(--shell);
  box-shadow: none;
}

.view-scroll {
  flex: 1 1 auto;
  min-height: 0;
  overflow-x: hidden;
  overflow-y: auto;
  overscroll-behavior: contain;
  scrollbar-width: thin;
  scrollbar-color: var(--line-strong) transparent;
  padding: 0 20px 24px;
}

.view-scroll::-webkit-scrollbar {
  width: 5px;
}

.view-scroll::-webkit-scrollbar-thumb {
  border-radius: 5px;
  background: var(--line-strong);
}

.status-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  min-height: 38px;
  margin-bottom: 22px;
  padding: 9px 12px;
  border: 1px solid rgba(52, 211, 153, 0.14);
  border-radius: 12px;
  color: var(--success);
  background: rgba(52, 211, 153, 0.06);
  font-size: 0.68rem;
}

.status-strip > span {
  display: flex;
  align-items: center;
  gap: 8px;
}

.status-strip small {
  color: var(--muted);
}

.section-heading,
.inbox-heading,
.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
}

.section-heading {
  margin: 4px 0 14px;
}

.section-heading h3,
.inbox-heading h3,
.sheet-header h3 {
  margin: 0;
  font-size: 1.3rem;
  letter-spacing: -0.035em;
}

.draft-status,
.model-badge {
  padding: 5px 8px;
  color: var(--faint);
  background: var(--surface-2);
}

.composer {
  display: block;
  overflow: hidden;
  border: 1px solid var(--line-strong);
  border-radius: var(--radius);
  background: var(--surface);
  transition: border-color var(--ease), box-shadow var(--ease);
}

.composer:focus-within {
  border-color: color-mix(in srgb, var(--mint) 50%, var(--line));
  box-shadow: 0 0 0 3px var(--mint-soft);
}

.composer textarea {
  min-height: 142px;
  padding: 16px;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  font-size: 0.88rem;
  line-height: 1.65;
}

.composer-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 9px 13px;
  border-top: 1px solid var(--line);
  color: var(--faint);
  background: color-mix(in srgb, var(--surface-2) 45%, transparent);
  font-size: 0.63rem;
}

.composer-meta > span:first-child {
  display: inline-flex;
  align-items: center;
  gap: 5px;
}

.composer-meta svg {
  color: var(--mint);
}

.smart-panel {
  min-height: 268px;
  margin-top: 13px;
  padding: 14px;
  border: 1px solid rgba(85, 167, 255, 0.15);
  border-radius: var(--radius);
  background: linear-gradient(145deg, var(--azure-soft), var(--surface) 36%);
}

.smart-panel.is-analyzing {
  border-color: rgba(99, 230, 190, 0.25);
}

.smart-header,
.smart-title,
.smart-title > span:last-child {
  display: flex;
  align-items: center;
}

.smart-header {
  justify-content: space-between;
  gap: 10px;
}

.smart-title {
  gap: 9px;
}

.smart-title > span:last-child {
  align-items: flex-start;
  flex-direction: column;
  gap: 2px;
}

.smart-title strong {
  font-size: 0.8rem;
}

.smart-title small {
  color: var(--muted);
  font-size: 0.64rem;
}

.ai-icon {
  display: inline-grid;
  width: 32px;
  height: 32px;
  place-items: center;
  border-radius: 10px;
  color: var(--mint);
  background: var(--mint-soft);
}

.is-analyzing .ai-icon svg {
  animation: breathe 1.1s ease-in-out infinite;
}

