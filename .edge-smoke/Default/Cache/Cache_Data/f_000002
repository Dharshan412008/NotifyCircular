  grid-template-columns: 39px 1fr auto;
  gap: 10px;
  align-items: center;
  min-height: 59px;
  padding: 9px 11px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: var(--surface);
}

.option-row-copy {
  display: grid;
  gap: 3px;
  min-width: 0;
}

.option-row strong {
  overflow: hidden;
  font-size: 0.75rem;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.option-row small {
  color: var(--muted);
  font-size: 0.61rem;
}

.option-row input {
  width: 20px;
  min-height: 20px;
  accent-color: var(--mint);
}

.review-card {
  padding: 14px;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--surface);
}

.review-card h4 {
  margin: 0 0 8px;
  font-size: 0.86rem;
}

.review-card p {
  display: -webkit-box;
  margin: 0;
  overflow: hidden;
  color: var(--muted);
  font-size: 0.72rem;
  line-height: 1.55;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.review-facts {
  display: grid;
  gap: 8px;
  margin-top: 13px;
}

.review-fact {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  color: var(--muted);
  font-size: 0.68rem;
}

.review-fact strong {
  color: var(--text-soft);
  text-align: right;
}

.review-actions {
  display: grid;
  grid-template-columns: 0.85fr 1.15fr;
  gap: 9px;
}

.toast-region {
  position: fixed;
  z-index: 100;
  top: 24px;
  left: 50%;
  display: grid;
  width: min(390px, calc(100vw - 28px));
  gap: 8px;
  transform: translateX(-50%);
  pointer-events: none;
}

.toast {
  display: grid;
  grid-template-columns: 32px 1fr auto;
  gap: 10px;
  align-items: center;
  padding: 11px 12px;
  border: 1px solid var(--line-strong);
  border-radius: 15px;
  color: var(--text);
  background: color-mix(in srgb, var(--surface) 94%, transparent);
  box-shadow: 0 16px 42px rgba(0, 0, 0, 0.28);
  backdrop-filter: blur(20px);
  pointer-events: auto;
  animation: toast-in 220ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes toast-in {
  from { opacity: 0; transform: translateY(-12px) scale(0.97); }
}

.toast-icon {
  display: inline-grid;
  width: 32px;
  height: 32px;
  place-items: center;
  border-radius: 10px;
  color: var(--mint);
  background: var(--mint-soft);
}

.toast-copy {
  display: grid;
  gap: 2px;
}

.toast-copy strong {
  font-size: 0.72rem;
}

.toast-copy small {
  color: var(--muted);
  font-size: 0.61rem;
  line-height: 1.35;
}

.toast button {
  width: 26px;
  height: 26px;
  padding: 0;
  border: 0;
  color: var(--faint);
  background: transparent;
}

@media (max-height: 760px) and (min-width: 601px) {
  .hero { margin-top: 28px; }
  .hero h1 { font-size: 2.25rem; }
  .landing-metrics { display: none; }
}

@media (max-width: 600px) {
  body {
    background: var(--shell);
  }

  .aurora {
    display: none;
  }

  .device {
    width: 100vw;
    height: 100dvh;
    min-height: 0;
    margin: 0;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  .device::before {
    display: none;
  }

  .screen {
    padding-top: calc(18px + env(safe-area-inset-top));
  }

  .app-screen {
    padding-top: calc(17px + env(safe-area-inset-top));
  }

  .sheet-dialog {
    width: 100vw;
  }

  .offline-banner {
    top: calc(8px + env(safe-area-inset-top));
  }
}

@media (max-width: 365px) {
  .screen {
    padding-right: 17px;
    padding-left: 17px;
  }

  .app-screen {
    padding-right: 0;
    padding-left: 0;
  }

  .view-scroll,
  .app-topbar,
  .detail-topbar {
    padding-right: 16px;
    padding-left: 16px;
  }

  .hero h1 {
    font-size: 2.15rem;
  }

  .analysis-grid {
    grid-template-columns: 1fr;
  }

  .landing-metrics {
    display: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
