# Server
# Normal email/password sign-in (default). No OTP or Google setup required.
# Optional: AUTH_MODE=college for college email OTP, google for OAuth.
AUTH_MODE=password
COLLEGE_EMAIL_DOMAINS=srishakthi.ac.in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# In Google Cloud, register APP_URL + /api/auth/google/callback as a redirect URI.
PORT=3000
HOST=127.0.0.1
SESSION_SECRET=replace-with-a-long-random-value
APP_URL=https://campus.example.edu
# Set to 1 only behind your trusted HTTPS reverse proxy.
TRUST_PROXY=
# Production never seeds demo accounts by default. Existing records are preserved.
SEED_DEMO_DATA=false
# Local delivery stays in preview mode unless explicitly enabled.
ALLOW_OUTBOUND_NOTIFICATIONS=false
DB_PATH=data/notify-circular.db

# SMTP_HOST and MAIL_FROM are REQUIRED for email OTP in college mode.
# Verification codes always use real SMTP; they are never previewed or logged.
# ALLOW_OUTBOUND_NOTIFICATIONS controls circular notifications separately.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional stable Web Push credentials. If omitted, a VAPID key pair is
# generated once and saved in the local SQLite settings table.
VAPID_SUBJECT=mailto:admin@example.edu
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
