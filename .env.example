# Server
PORT=3000
HOST=127.0.0.1
SESSION_SECRET=replace-with-a-long-random-value
DB_PATH=data/notify-circular.db

# Optional SMTP. When omitted, email fallback is captured by a local JSON
# transport so the full delivery path can be demonstrated without an account.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CampusRelay <no-reply@example.edu>

# Optional stable Web Push credentials. If omitted, a VAPID key pair is
# generated once and saved in the local SQLite settings table.
VAPID_SUBJECT=mailto:admin@example.edu
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
