{
  "name": "notify-circular",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-user college circular routing, notification, and accountability demo",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server.js",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:api && npm run test:client",
    "test:api": "node --test --test-concurrency=1 test/*.test.js",
    "test:client": "vitest run",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm test && npm run test:e2e",
    "typecheck": "tsc --noEmit",
    "create-admin": "node scripts/create-admin.js"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.85.5",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.18.2",
    "framer-motion": "^13.2.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.542.0",
    "nodemailer": "^9.0.6",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.87.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.1.3",
    "vitest": "^4.1.11"
  }
}
